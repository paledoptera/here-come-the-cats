"update": 1,
"values": ["", "[shake]I know it's somewhere...", "[shake][color=red]Somewhere...", "[wave]If you're looking for the old house,", "[wave]This is the way.", "[wave]Call me on a Sunday, baby,", "[wave]Tell me to stay.", "Walk me off a cliff as you", "Float in the air", "And I'll fall straight down,", "while I reach for your hair.", "You should've been the rainstorm,", "I'd have been dirt.", "We'd have washed away and sunk ", "deep in the earth.", "But, no, I was a dog,", "and you were a rat...", "[shake]Oh here come the cats.", "[shake]So blow me like a Kennedy,", "[shake]Burn like the sun!", "[shake]I will be the bullet", "[shake]Baby, you be the gun!", "[shake]Rock me like a senator,", "[shake]Kidnap the judge", "[shake]But you're gonna have to", "[shake]TORTURE ME", "[shake]TO", "[shake]SHUT ME UP", "[shake]HERE COME THE CATS!", "[shake]RUN LITTLE RAT!", "[shake]HERE COME THE CATS!", "[shake]RUN LITTLE RAT!", "You can play the landslide", "I can play dead.", "We can toss around", "all the knives in your head.", "Jesus will come back", "and He'll set us on fire", "and you and I will sing again...", "I can still remember you", "Sitting in the kitchen", "Laughing in the distance, darling", "I shouldn't miss it", "But it used to thrill me", "I guess I miss it", "You exist to kill me.", "So lock me up", "and toss the key.", "Wash away your sins at Mass", "Little rats might set you free, but", "[shake]Here come the cats.", "[shake]So blow me like a Kennedy,", "[shake]Burn like the sun!", "[shake]I will be the bullet", "[shake]Baby, you be the gun!", "[shake]Rock me like a senator,", "[shake]Kidnap the judge", "[shake]But you're gonna have to", "[shake]TORTURE ME", "[shake]TO", "[shake]SHUT ME UP", "[shake]HERE COME THE CATS!", "[shake]RUN LITTLE RAT!", "[shake]HERE COME THE CATS!", "[shake]RUN LITTLE RAT!", ""]
}
