[sub_resource type="GDScript" id="GDScript_vpd5p"]
resource_name = "Charge"
script/source = "extends AudioStreamPlayer

@onready var soul: Soul = get_parent()

func _process(delta: float) -> void:
	if soul.shoot_state == soul.ShootState.CHARGING:
		if not playing:
			playing = true
		pitch_scale = min(0.25 + (soul.charge_timer * 0.05),1)
		print(\"TEST\", linear_to_db(0.5))
	else:
		playing = false
					#snd_pitch(loop_sound, min(0.5 + (chargetimer * 0.05), 1));
"

[sub_resource type="GDScript" id="GDScript_nbd1g"]
resource_name = "Wind"
script/source = "extends AudioStreamPlayer

@onready var soul: Soul = get_parent()
var wait_time: float = 0.0
var velocity: float = 0.0

func _process(delta: float) -> void:
	velocity = lerpf(velocity, (soul.velocity.length() * 0.003),0.1)
	
	if soul.dashing:
		wait_time += delta
		if wait_time > 0.08:
			wait_time -= 0.08
			Sound.play(preload(\"uid://bi7px1mguwaaa\"),volume_linear*2,velocity*1.5)

		
		
		pitch_scale = min(0.1 + velocity, 2.0)
		volume_linear = lerp(volume_linear,0.2,0.3)
	else:
		wait_time = 0.08
		volume_linear = lerp(volume_linear,0.0,0.1)
	
	
"

