[sub_resource type="GDScript" id="GDScript_76v1n"]
resource_name = "HeartOutline"
script/source = "extends TextureProgressBar

@onready var soul: Soul = get_owner()

func _process(delta: float) -> void:
	
	if soul.charge_timer == 16.0:
		modulate = Color.TRANSPARENT
	else:
		modulate = lerp(Color(\"ffffff50\"),Color(\"ffffff\"),max(soul.charge_timer-2.0,0.0)/16.0)
	
	
	
	match soul.shoot_state:
		soul.ShootState.CHARGING:
			visible = true
			value = (soul.charge_timer)
			max_value = soul.charge_max
		soul.ShootState.SHOOT:
			visible = true
			value = (soul.dash_flash)
			max_value = (soul.charge_max)
		_:
			visible = false
"

[sub_resource type="GDScript" id="GDScript_ooxh1"]
resource_name = "OrangeDots"
script/source = "extends Node2D

@onready var soul: Soul = get_owner()

var base_offset: float = 35.0
var offset: float = 0.0

func _process(delta: float) -> void:
	rotate(5.0 * delta)
	
	
	modulate = lerp(Color(\"ffffff00\"),Color(\"ffffff\"),max(soul.charge_timer-2.0,0.0)/16.0)
	
	match soul.shoot_state:

		soul.ShootState.CHARGING:
			visible = true
			offset = lerp(base_offset,0.0,soul.charge_timer/16.0)
		_:
			visible = false
			
	
	var rot = 0.0
	
	
	
	for i in get_children():
		
		rot += 90.0
		i.position = Vector2(0.0,offset).rotated(deg_to_rad(rot))
		i.scale = (Vector2.ONE - (Vector2.ONE * soul.charge_timer)/32) * 4.0
		
		i.global_rotation = 0.0
"

