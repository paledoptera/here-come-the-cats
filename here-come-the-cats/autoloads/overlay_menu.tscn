[sub_resource type="GDScript" id="GDScript_5gacp"]
resource_name = "RestartingLabel"
script/source = "extends Label

func _process(delta: float) -> void:
	modulate = Color.TRANSPARENT.lerp(Color.WHITE,get_owner().command_timer)
	match OverlayMenu.command:
		OverlayMenu.Command.QUIT:
			text = \"Quitting...\"
		OverlayMenu.Command.RESTART:
			text = \"Restarting...\"
			
"

[node name="OverlayMenu" type="Node" unique_id=1985960612]
script = ExtResource("1_5gacp")

